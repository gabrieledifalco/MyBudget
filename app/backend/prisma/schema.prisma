// Schema dati MyBudget - vedi README.md per i requisiti funzionali.
// Provider SQLite per lo sviluppo locale: per PostgreSQL basta cambiare provider e DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  profileType  String   @default("INDIVIDUAL") // INDIVIDUAL | FAMILY
  onboardingComplete Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  familyMembers       FamilyMember[]
  housing             Housing?
  incomes             Income[]
  passiveIncomes      PassiveIncome[]
  expenses            Expense[]
  loans               Loan[]
  simulations         Simulation[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FamilyMember {
  id            String  @id @default(cuid())
  userId        String
  firstName     String
  lastName      String
  role          String // SPOUSE | CHILD | PARENT | OTHER
  producesIncome Boolean @default(false)
  order         Int     @default(0) // per il riordino manuale (drag & drop) nel nucleo

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  loans    Loan[]

  @@index([userId])
}

model Housing {
  id             String  @id @default(cuid())
  userId         String  @unique
  type           String // OWNED | MORTGAGE | RENT
  propertyValue  Float?
  mortgagePayment Float?
  mortgageYears  Int?
  rentAmount     Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Income {
  id                String  @id @default(cuid())
  userId            String
  employmentType    String // EMPLOYEE | FREELANCER | VAT | RETIRED | OTHER
  netMonthly        Float   @default(0)
  grossAnnual       Float   @default(0)
  monthlyPaymentsCount Int  @default(12) // numero mensilità annue
  thirteenthSalary  Float?
  fourteenthSalary  Float?
  annualBonus       Float?
  taxRate           Float? // % per professionisti / partita IVA
  taxFrequency      String? // MONTHLY | QUARTERLY | YEARLY
  taxSetAside       Float?
  memberId          String? // opzionale: reddito di un membro del nucleo
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  history IncomeHistory[]

  @@index([userId])
}

// Storico delle variazioni di reddito (README: "tutte le variazioni devono essere storicizzate").
model IncomeHistory {
  id               String   @id @default(cuid())
  incomeId         String
  netMonthly       Float
  grossAnnual      Float
  monthlyPaymentsCount Int @default(12)
  thirteenthSalary Float?
  fourteenthSalary Float?
  annualBonus      Float?
  recordedAt       DateTime @default(now())

  income Income @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@index([incomeId])
}

model PassiveIncome {
  id          String   @id @default(cuid())
  userId      String
  type        String // RENT | DIVIDEND | FUND | INVESTMENT | PENSION | OTHER
  description String
  amount      Float
  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  startDate   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       String @id @default(cuid())
  name     String @unique
  macroArea String // HOME | CAR | SPORT | FAMILY | INVESTMENT | LEISURE | OTHER
  isDefault Boolean @default(true)

  expenses Expense[]
  loans    Loan[]
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String?
  memberId    String? // opzionale: uscita imputata a un singolo membro del nucleo (altrimenti generica/familiare)
  name        String
  description String?
  kind        String // FIXED | VARIABLE
  amount      Float
  date        DateTime @default(now()) // data dell'uscita (occorrenza singola o riferimento per quelle ricorrenti)
  isRecurring Boolean  @default(true) // se falsa è un'uscita singola sulla sola `date`, la frequency viene ignorata
  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  utility     Int      @default(3) // 1 superflua ... 5 essenziale
  startDate   DateTime?
  endDate     DateTime?
  receiptUrl  String? // percorso dello scontrino archiviato
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id])
  member   FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@index([memberId])
}

model Loan {
  id             String   @id @default(cuid())
  userId         String
  categoryId     String?
  memberId       String? // intestatario del finanziamento
  name           String
  description    String?
  totalAmount    Float
  monthlyPayment Float
  startDate      DateTime
  endDate        DateTime

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id])
  member   FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@index([memberId])
}

model Simulation {
  id        String   @id @default(cuid())
  userId    String
  name      String
  payload   String // JSON con gli scenari applicati
  result    String // JSON con l'esito calcolato
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
